;; References of every kind in struct fields and array elements survive collections and move.
(module
  (type $leaf (struct (field i32)))
  (type $f (func (result i32)))
  (type $c (cont $f))
  (type $refs (struct
    (field (mut (ref null $f)))
    (field (mut externref))
    (field (mut anyref))
    (field (mut anyref))
    (field (mut anyref))
    (field (mut exnref))
    (field (mut (ref null $c)))
    (field i32)))
  (type $anys (array (mut anyref)))
  (type $exts (array (mut externref)))
  (type $exns (array (mut exnref)))
  (type $conts (array (mut (ref null $c))))
  (type $funcs (array (mut (ref null $f))))
  (type $bytes (array (mut i8)))
  (tag $e (param i32))
  (global $s (mut (ref null $refs)) (ref.null $refs))
  (global $anys (mut (ref null $anys)) (ref.null $anys))
  (global $exts (mut (ref null $exts)) (ref.null $exts))
  (global $exns (mut (ref null $exns)) (ref.null $exns))
  (global $conts (mut (ref null $conts)) (ref.null $conts))
  (global $funcs (mut (ref null $funcs)) (ref.null $funcs))
  (elem declare func $seven $eight)
  (func $seven (type $f) (i32.const 7))
  (func $eight (type $f) (i32.const 8))
  (func $exn (param i32) (result exnref)
    (block $h (result exnref)
      (try_table (catch_all_ref $h) (throw $e (local.get 0)))
      (unreachable)))
  (func $payload (param exnref) (result i32)
    (block $h (result i32)
      (try_table (catch $e $h) (throw_ref (local.get 0)))
      (unreachable)))
  (func $churn
    (local $n i32)
    (local.set $n (i32.const 128))
    (loop $l
      (drop (array.new_default $bytes (i32.const 65536)))
      (br_if $l (local.tee $n (i32.sub (local.get $n) (i32.const 1))))))

  (func (export "fill") (param $x externref) (param $y externref)
    (global.set $s
      (struct.new $refs
        (ref.func $seven)
        (local.get $x)
        (struct.new $leaf (i32.const 42))
        (ref.i31 (i32.const -5))
        (any.convert_extern (local.get $y))
        (call $exn (i32.const 11))
        (cont.new $c (ref.func $eight))
        (i32.const 99)))
    (global.set $anys (array.new_default $anys (i32.const 4)))
    (array.set $anys (global.get $anys) (i32.const 1) (struct.new $leaf (i32.const 43)))
    (array.set $anys (global.get $anys) (i32.const 2) (ref.i31 (i32.const 6)))
    (array.set $anys (global.get $anys) (i32.const 3) (any.convert_extern (local.get $y)))
    (global.set $exts (array.new $exts (local.get $x) (i32.const 3)))
    (global.set $exns (array.new_default $exns (i32.const 3)))
    (array.set $exns (global.get $exns) (i32.const 1) (call $exn (i32.const 12)))
    (global.set $conts (array.new_default $conts (i32.const 3)))
    (array.set $conts (global.get $conts) (i32.const 2) (cont.new $c (ref.func $seven)))
    (global.set $funcs (array.new $funcs (ref.func $eight) (i32.const 3)))
    (call $churn))

  (func (export "struct_func") (result i32) (call_ref $f (struct.get $refs 0 (global.get $s))))
  (func (export "struct_extern") (result externref) (struct.get $refs 1 (global.get $s)))
  (func (export "struct_leaf") (result i32)
    (struct.get $leaf 0 (ref.cast (ref $leaf) (struct.get $refs 2 (global.get $s)))))
  (func (export "struct_i31") (result i32)
    (i31.get_s (ref.cast (ref i31) (struct.get $refs 3 (global.get $s)))))
  (func (export "struct_host") (result externref) (extern.convert_any (struct.get $refs 4 (global.get $s))))
  (func (export "struct_exn") (result i32) (call $payload (struct.get $refs 5 (global.get $s))))
  (func (export "struct_cont") (result i32) (resume $c (struct.get $refs 6 (global.get $s))))
  (func (export "struct_i32") (result i32) (struct.get $refs 7 (global.get $s)))

  (func (export "array_leaf") (result i32)
    (struct.get $leaf 0 (ref.cast (ref $leaf) (array.get $anys (global.get $anys) (i32.const 1)))))
  (func (export "array_i31") (result i32)
    (i31.get_s (ref.cast (ref i31) (array.get $anys (global.get $anys) (i32.const 2)))))
  (func (export "array_host") (result externref)
    (extern.convert_any (array.get $anys (global.get $anys) (i32.const 3))))
  (func (export "array_null") (result i32) (ref.is_null (array.get $anys (global.get $anys) (i32.const 0))))
  (func (export "array_extern") (result externref) (array.get $exts (global.get $exts) (i32.const 2)))
  (func (export "array_exn") (result i32) (call $payload (array.get $exns (global.get $exns) (i32.const 1))))
  (func (export "array_cont") (result i32) (resume $c (array.get $conts (global.get $conts) (i32.const 2))))
  (func (export "array_func") (result i32) (call_ref $f (array.get $funcs (global.get $funcs) (i32.const 1))))
  (func (export "churn") (call $churn)))

(assert_return (invoke "fill" (ref.extern 1) (ref.extern 2)))
(assert_return (invoke "churn"))
(assert_return (invoke "struct_func") (i32.const 7))
(assert_return (invoke "struct_extern") (ref.extern 1))
(assert_return (invoke "struct_leaf") (i32.const 42))
(assert_return (invoke "struct_i31") (i32.const -5))
(assert_return (invoke "struct_host") (ref.extern 2))
(assert_return (invoke "struct_exn") (i32.const 11))
(assert_return (invoke "struct_cont") (i32.const 8))
(assert_return (invoke "struct_i32") (i32.const 99))
(assert_return (invoke "array_leaf") (i32.const 43))
(assert_return (invoke "array_i31") (i32.const 6))
(assert_return (invoke "array_host") (ref.extern 2))
(assert_return (invoke "array_null") (i32.const 1))
(assert_return (invoke "array_extern") (ref.extern 1))
(assert_return (invoke "array_exn") (i32.const 12))
(assert_return (invoke "array_cont") (i32.const 7))
(assert_return (invoke "array_func") (i32.const 8))
(assert_trap (invoke "struct_cont") "continuation already consumed")

;; Bulk array operations: overlapping copies, zero lengths, fills, and bounds traps.
(module
  (type $i32s (array (mut i32)))
  (type $i16s (array (mut i16)))
  (type $v128s (array (mut v128)))
  (type $anys (array (mut anyref)))
  (type $leaf (struct (field i32)))
  (global $a (mut (ref null $i32s)) (ref.null $i32s))
  (global $h (mut (ref null $i16s)) (ref.null $i16s))
  (global $v (mut (ref null $v128s)) (ref.null $v128s))
  (global $r (mut (ref null $anys)) (ref.null $anys))
  (func $reset
    (global.set $a (array.new_fixed $i32s 8
      (i32.const 0) (i32.const 1) (i32.const 2) (i32.const 3)
      (i32.const 4) (i32.const 5) (i32.const 6) (i32.const 7))))
  (func (export "sum") (result i32)
    (local $i i32) (local $s i32)
    (loop $l
      (local.set $s (i32.add (i32.mul (local.get $s) (i32.const 10))
                             (array.get $i32s (global.get $a) (local.get $i))))
      (br_if $l (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 8))))
    (local.get $s))
  (func (export "copy") (param $dst i32) (param $src i32) (param $n i32)
    (call $reset)
    (array.copy $i32s $i32s (global.get $a) (local.get $dst) (global.get $a) (local.get $src) (local.get $n)))
  (func (export "fill") (param $dst i32) (param $x i32) (param $n i32)
    (call $reset)
    (array.fill $i32s (global.get $a) (local.get $dst) (local.get $x) (local.get $n)))
  (func (export "fill_i16") (param $n i32) (result i32)
    (global.set $h (array.new_default $i16s (i32.const 9)))
    (array.fill $i16s (global.get $h) (i32.const 1) (i32.const 0x12345) (local.get $n))
    (i32.add
      (i32.mul (array.get_s $i16s (global.get $h) (i32.const 0)) (i32.const 1000000))
      (i32.add (array.get_u $i16s (global.get $h) (local.get $n))
               (array.get_u $i16s (global.get $h) (i32.const 8)))))
  (func (export "fill_v128") (result i32)
    (global.set $v (array.new_default $v128s (i32.const 5)))
    (array.fill $v128s (global.get $v) (i32.const 1) (v128.const i32x4 1 2 3 4) (i32.const 3))
    (array.copy $v128s $v128s (global.get $v) (i32.const 0) (global.get $v) (i32.const 1) (i32.const 4))
    (i32.add
      (i32x4.extract_lane 3 (array.get $v128s (global.get $v) (i32.const 0)))
      (i32x4.extract_lane 2 (array.get $v128s (global.get $v) (i32.const 2)))))
  (func (export "refs") (result i32)
    (global.set $r (array.new_default $anys (i32.const 4)))
    (array.fill $anys (global.get $r) (i32.const 0) (struct.new $leaf (i32.const 5)) (i32.const 2))
    (array.copy $anys $anys (global.get $r) (i32.const 1) (global.get $r) (i32.const 0) (i32.const 3))
    (i32.add
      (struct.get $leaf 0 (ref.cast (ref $leaf) (array.get $anys (global.get $r) (i32.const 2))))
      (ref.is_null (array.get $anys (global.get $r) (i32.const 3))))))

(assert_return (invoke "copy" (i32.const 2) (i32.const 0) (i32.const 5)))
(assert_return (invoke "sum") (i32.const 1012347))
(assert_return (invoke "copy" (i32.const 0) (i32.const 2) (i32.const 5)))
(assert_return (invoke "sum") (i32.const 23456567))
(assert_return (invoke "copy" (i32.const 8) (i32.const 0) (i32.const 0)))
(assert_return (invoke "sum") (i32.const 1234567))
(assert_trap (invoke "copy" (i32.const 4) (i32.const 0) (i32.const 5)) "out of bounds array access")
(assert_trap (invoke "copy" (i32.const 9) (i32.const 0) (i32.const 0)) "out of bounds array access")
(assert_return (invoke "fill" (i32.const 1) (i32.const 9) (i32.const 6)))
(assert_return (invoke "sum") (i32.const 9999997))
(assert_return (invoke "fill" (i32.const 8) (i32.const 9) (i32.const 0)))
(assert_return (invoke "sum") (i32.const 1234567))
(assert_trap (invoke "fill" (i32.const 3) (i32.const 9) (i32.const 6)) "out of bounds array access")
(assert_return (invoke "fill_i16" (i32.const 7)) (i32.const 9029))
(assert_return (invoke "fill_v128") (i32.const 7))
(assert_return (invoke "refs") (i32.const 6))

;; array.new_data and array.init_data read little-endian elements of every width.
(module
  (type $i8s (array (mut i8)))
  (type $i16s (array (mut i16)))
  (type $i32s (array (mut i32)))
  (type $i64s (array (mut i64)))
  (type $f32s (array (mut f32)))
  (type $f64s (array (mut f64)))
  (type $v128s (array (mut v128)))
  (data $d "\01\82\03\84\05\86\07\88\09\8a\0b\8c\0d\8e\0f\90\00\00\c0\3f\00\00\00\00\00\00\f8\3f")
  (func (export "i8") (param $i i32) (result i32) (array.get_s $i8s (array.new_data $i8s $d (i32.const 0) (i32.const 4)) (local.get $i)))
  (func (export "i16") (param $i i32) (result i32) (array.get_u $i16s (array.new_data $i16s $d (i32.const 1) (i32.const 3)) (local.get $i)))
  (func (export "i32") (param $i i32) (result i32) (array.get $i32s (array.new_data $i32s $d (i32.const 0) (i32.const 4)) (local.get $i)))
  (func (export "i64") (param $i i32) (result i64) (array.get $i64s (array.new_data $i64s $d (i32.const 0) (i32.const 2)) (local.get $i)))
  (func (export "f32") (result f32) (array.get $f32s (array.new_data $f32s $d (i32.const 16) (i32.const 1)) (i32.const 0)))
  (func (export "f64") (result f64) (array.get $f64s (array.new_data $f64s $d (i32.const 20) (i32.const 1)) (i32.const 0)))
  (func (export "v128") (result i32)
    (i8x16.extract_lane_u 15 (array.get $v128s (array.new_data $v128s $d (i32.const 0) (i32.const 1)) (i32.const 0))))
  (func (export "init") (param $dst i32) (param $src i32) (param $n i32) (result i32)
    (local $a (ref $i16s))
    (local.set $a (array.new_default $i16s (i32.const 4)))
    (array.init_data $i16s $d (local.get $a) (local.get $dst) (local.get $src) (local.get $n))
    (i32.add (i32.mul (array.get_u $i16s (local.get $a) (i32.const 0)) (i32.const 65536))
             (array.get_u $i16s (local.get $a) (i32.const 3))))
  (func (export "empty") (result i32) (array.len (array.new_data $i64s $d (i32.const 28) (i32.const 0)))))

(assert_return (invoke "i8" (i32.const 1)) (i32.const -126))
(assert_return (invoke "i8" (i32.const 3)) (i32.const -124))
(assert_return (invoke "i16" (i32.const 0)) (i32.const 0x0382))
(assert_return (invoke "i16" (i32.const 2)) (i32.const 0x0786))
(assert_return (invoke "i32" (i32.const 1)) (i32.const 0x88078605))
(assert_return (invoke "i32" (i32.const 3)) (i32.const 0x900f8e0d))
(assert_return (invoke "i64" (i32.const 1)) (i64.const 0x900f8e0d8c0b8a09))
(assert_return (invoke "f32") (f32.const 1.5))
(assert_return (invoke "f64") (f64.const 1.5))
(assert_return (invoke "v128") (i32.const 0x90))
(assert_return (invoke "init" (i32.const 0) (i32.const 2) (i32.const 4)) (i32.const 0x84038a09))
(assert_return (invoke "init" (i32.const 4) (i32.const 28) (i32.const 0)) (i32.const 0))
(assert_return (invoke "empty") (i32.const 0))
(assert_trap (invoke "init" (i32.const 1) (i32.const 0) (i32.const 4)) "out of bounds array access")
(assert_trap (invoke "init" (i32.const 0) (i32.const 24) (i32.const 3)) "out of bounds memory access")
