(module
  (type $f (func (result i32)))
  (type $s (struct (field i32)))
  (type $a (array i8))
  (type $c (cont $f))
  (func $nofunc (param (ref nofunc)) (result (ref $f)) (local.get 0))
  (func $none-struct (param (ref none)) (result (ref $s)) (local.get 0))
  (func $none-array (param (ref none)) (result (ref $a)) (local.get 0))
  (func $nocont (param (ref nocont)) (result (ref $c)) (local.get 0))
  (func $nofunc-null (param (ref nofunc)) (result (ref null $f)) (local.get 0))
  (func $none-null (param (ref none)) (result (ref null $s)) (local.get 0))
  (func $nocont-null (param (ref nocont)) (result (ref null $c)) (local.get 0))
  (func $abstract (param (ref nofunc) (ref none) (ref noextern) (ref noexn) (ref nocont))
        (result (ref func) (ref any) (ref extern) (ref exn) (ref cont))
    (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4))
  (func $abstract-null (param (ref nofunc) (ref none) (ref noextern) (ref noexn) (ref nocont))
        (result funcref eqref externref exnref contref)
    (local.get 0) (local.get 1) (local.get 2) (local.get 3) (local.get 4))
  (func (export "unreachable-cast") (result i32)
    (block $l (result (ref $s))
      (br_on_cast $l anyref (ref $s) (ref.null none))
      (drop)
      (return (i32.const 0)))
    (drop)
    (i32.const 1))
  (global (export "g") (ref null $s) (ref.null none))
  (table 1 (ref null $f))
)
(assert_return (invoke "unreachable-cast") (i32.const 0))

(module
  (type $s (struct))
  (type $f (func))
  (func $struct (param (ref none)) (result (ref $s)) (unreachable))
  (func $func (param (ref nofunc)) (result (ref $f)) (unreachable))
  (func (export "call") (param (ref none)) (result (ref $s)) (call $struct (local.get 0)))
)

(module
  (type $s (struct))
  (type $f (func))
  (type $c (cont $f))
  (type $r (sub (func (result (ref $s) (ref $f) (ref $c)))))
  (type $b (sub $r (func (result (ref none) (ref nofunc) (ref nocont)))))
  (type $t (sub (struct (field (ref $s)) (field (ref $f)))))
  (type $u (sub $t (struct (field (ref none)) (field (ref nofunc)))))
  (func $bottoms (type $b) (unreachable))
  (elem declare func $bottoms)
  (func (export "call") (result i32)
    (block $l (result (ref $r))
      (br_on_cast $l funcref (ref $r) (ref.func $bottoms))
      (return (i32.const 0)))
    (drop)
    (i32.const 1))
  (func (param (ref none) (ref nofunc)) (result (ref $t))
    (struct.new $t (local.get 0) (local.get 1)))
  (func (param i32 (ref none) (ref $s)) (result (ref $s))
    (select (result (ref $s)) (local.get 1) (local.get 2) (local.get 0)))
  (func (param (ref nofunc)) (call_ref $f (local.get 0)))
  (func (param (ref none)) (result (ref $s))
    (block $l (result (ref $s)) (br $l (local.get 0))))
)
(assert_return (invoke "call") (i32.const 1))

(assert_invalid
  (module (type $f (func)) (func (param (ref null nofunc)) (result (ref $f)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (type $s (struct)) (func (param (ref null none)) (result (ref $s)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (type $f (func)) (type $c (cont $f)) (func (param (ref null nocont)) (result (ref $c)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (type $f (func)) (func (param (ref nofunc)) (result (ref $f)) (ref.null nofunc)))
  "type mismatch")
(assert_invalid
  (module (type $f (func)) (func (param (ref none)) (result (ref $f)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (type $s (struct)) (func (param (ref nofunc)) (result (ref $s)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (type $f (func)) (type $c (cont $f)) (func (param (ref nofunc)) (result (ref $c)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (type $s (struct)) (func (param (ref noextern)) (result (ref $s)) (local.get 0)))
  "type mismatch")
(assert_invalid
  (module (func (param (ref noexn)) (result (ref any)) (local.get 0)))
  "type mismatch")
