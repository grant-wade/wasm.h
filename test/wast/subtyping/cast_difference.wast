(assert_invalid
  (module
    (type $t (struct))
    (func (param (ref null $t)) (result (ref null none))
      (block $l (result (ref $t))
        (br_on_cast $l (ref null $t) (ref $t) (local.get 0))
        (return))
      (unreachable)))
  "type mismatch")
(assert_invalid
  (module
    (type $t (struct))
    (func (param (ref null $t)) (result (ref null none))
      (block $l (result (ref null none))
        (br_on_cast_fail $l (ref null $t) (ref $t) (local.get 0))
        (drop) (unreachable))))
  "type mismatch")
(assert_invalid
  (module
    (func (param anyref) (result nullref)
      (block $l (result (ref any))
        (br_on_cast $l anyref (ref any) (local.get 0))
        (return))
      (unreachable)))
  "type mismatch")

(module
  (type $t (struct))
  (func (export "fallthrough") (param (ref null $t)) (result i32)
    (block $l (result (ref $t))
      (br_on_cast $l (ref null $t) (ref $t) (local.get 0))
      (ref.is_null)
      (return))
    (drop)
    (i32.const 2))
  (func (export "branch") (param (ref null $t)) (result i32)
    (block $l (result (ref null $t))
      (br_on_cast_fail $l (ref null $t) (ref $t) (local.get 0))
      (drop)
      (return (i32.const 2)))
    (ref.is_null))
  (func (export "null") (result i32)
    (call 0 (ref.null $t)))
  (func (export "null_fail") (result i32)
    (call 1 (ref.null $t)))
  (func (export "object") (result i32)
    (call 0 (struct.new $t)))
  (func (export "object_fail") (result i32)
    (call 1 (struct.new $t))))
(assert_return (invoke "null") (i32.const 1))
(assert_return (invoke "null_fail") (i32.const 1))
(assert_return (invoke "object") (i32.const 2))
(assert_return (invoke "object_fail") (i32.const 2))
