(module $A
  (type $pad (array i8))
  (type $base (sub (struct (field (mut i32)))))
  (type $derived (sub $base (struct (field (mut i32)) (field i64))))
  (type $arr (array (mut i32)))
  (type $f (func (param i32) (result i32)))
  (func $id (type $f) (local.get 0))
  (elem declare func $id)
  (global (export "gs") (ref $base) (struct.new $base (i32.const 7)))
  (func (export "make-base") (result (ref $base)) (struct.new $base (i32.const 1)))
  (func (export "make-derived") (result (ref $derived)) (struct.new $derived (i32.const 2) (i64.const 3)))
  (func (export "make-array") (result (ref $arr)) (array.new $arr (i32.const 4) (i32.const 3)))
  (func (export "make-any") (result anyref) (struct.new $derived (i32.const 5) (i64.const 6)))
  (func (export "make-func") (result funcref) (ref.func $id))
)
(register "A")

(module
  (type $f (func (param i32) (result i32)))
  (type $base (sub (struct (field (mut i32)))))
  (type $derived (sub $base (struct (field (mut i32)) (field i64))))
  (type $other (struct (field (mut i32))))
  (type $arr (array (mut i32)))
  (import "A" "gs" (global $gs (ref $base)))
  (import "A" "make-base" (func $make-base (result (ref $base))))
  (import "A" "make-derived" (func $make-derived (result (ref $derived))))
  (import "A" "make-array" (func $make-array (result (ref $arr))))
  (import "A" "make-any" (func $make-any (result anyref)))
  (import "A" "make-func" (func $make-func (result funcref)))
  (func (export "get-global") (result i32) (struct.get $base 0 (global.get $gs)))
  (func (export "get-derived") (result i64) (struct.get $derived 1 (call $make-derived)))
  (func (export "set-get") (result i32)
    (local $x (ref $base))
    (local.set $x (call $make-base))
    (struct.set $base 0 (local.get $x) (i32.const 11))
    (struct.get $base 0 (local.get $x)))
  (func (export "array") (result i32)
    (local $a (ref $arr))
    (local.set $a (call $make-array))
    (array.set $arr (local.get $a) (i32.const 1) (i32.const 9))
    (i32.add (array.get $arr (local.get $a) (i32.const 1)) (array.len (local.get $a))))
  (func (export "test-derived") (result i32) (ref.test (ref $derived) (call $make-any)))
  (func (export "test-base") (result i32) (ref.test (ref $base) (call $make-any)))
  (func (export "test-other") (result i32) (ref.test (ref $other) (call $make-any)))
  (func (export "cast") (result i64) (struct.get $derived 1 (ref.cast (ref $derived) (call $make-any))))
  (func (export "cast-fail") (drop (ref.cast (ref $other) (call $make-any))))
  (func (export "br-on-cast") (result i32)
    (block $l (result (ref $derived))
      (br_on_cast $l anyref (ref $derived) (call $make-any))
      (drop)
      (return (i32.const -1)))
    (struct.get $derived 0))
  (func (export "br-on-cast-fail") (result i32)
    (block $l (result anyref)
      (br_on_cast_fail $l anyref (ref $other) (call $make-any))
      (drop)
      (return (i32.const -1)))
    (drop)
    (i32.const 1))
  (func (export "test-func") (result i32) (ref.test (ref $f) (call $make-func)))
  (func (export "cast-func") (result i32) (call_ref $f (i32.const 3) (ref.cast (ref $f) (call $make-func))))
)
(assert_return (invoke "get-global") (i32.const 7))
(assert_return (invoke "get-derived") (i64.const 3))
(assert_return (invoke "set-get") (i32.const 11))
(assert_return (invoke "array") (i32.const 12))
(assert_return (invoke "test-derived") (i32.const 1))
(assert_return (invoke "test-base") (i32.const 1))
(assert_return (invoke "test-other") (i32.const 0))
(assert_return (invoke "cast") (i64.const 6))
(assert_trap (invoke "cast-fail") "cast failure")
(assert_return (invoke "br-on-cast") (i32.const 5))
(assert_return (invoke "br-on-cast-fail") (i32.const 1))
(assert_return (invoke "test-func") (i32.const 1))
(assert_return (invoke "cast-func") (i32.const 3))

(module $R
  (type $base (sub (struct (field (mut i32)))))
  (import "A" "gs" (global $g (ref $base)))
  (export "gs" (global $g)))
(register "R")
(module
  (type $pad (array i8))
  (type $base (sub (struct (field (mut i32)))))
  (import "R" "gs" (global $g (ref $base)))
  (func (export "get") (result i32) (struct.get $base 0 (global.get $g))))
(assert_return (invoke "get") (i32.const 7))
