(assert_invalid
  (module (rec (type $A (descriptor $D) (struct)) (type $D (describes $A) (struct)))
    (func (param (ref null $A) (ref null (exact $D))) (result (ref $A))
      (block $l (result (ref null $A))
        (br_on_cast_desc_eq $l (ref null $A) (ref $A) (local.get 0) (local.get 1))
        (return))
      (unreachable)))
  "type mismatch")
(assert_invalid
  (module (type $s (struct))
    (func (param (ref (exact $s)) (ref $s)) (result (ref (exact $s)))
      (select (result (ref $s)) (local.get 0) (local.get 1) (i32.const 0))))
  "type mismatch")
(assert_invalid
  (module (rec
    (type $A (sub (descriptor $Ad) (struct)))
    (type $Ad (sub (describes $A) (struct)))
    (type $B (sub $A (descriptor $Bd) (struct)))
    (type $Bd (sub $Ad (describes $B) (struct)))
    (type $C (sub $B (descriptor $Cd) (struct)))
    (type $Cd (sub $Ad (describes $C) (struct)))))
  "descriptor type 5 does not match")
(assert_invalid
  (module (rec
    (type $A (sub (descriptor $Ad) (struct)))
    (type $Ad (sub (describes $A) (struct)))
    (type $B (sub $A (descriptor $Bd) (struct)))
    (type $Bd (sub $Ad (describes $B) (struct)))
    (type $C (sub $A (descriptor $Cd) (struct)))
    (type $Cd (sub $Bd (describes $C) (struct)))))
  "described type 4 does not match")
(module
  (type $s (struct (field (ref null (exact $s)))))
  (type $a (array (ref null (exact $s))))
  (type $f (func (param (ref null (exact $s))) (result (ref null (exact $s)))))
  (global $g (mut (ref null (exact $s))) (ref.null none))
  (table $t 1 (ref null (exact $s)))
  (tag $e (param (ref null (exact $s))))
  (func $id (type $f) (local.get 0))
  (func (param $p (ref null (exact $s))) (param $x (ref null (exact $a))) (result (ref (exact $s)))
    (local $l (ref null (exact $s)))
    (local.set $l (local.tee $l (local.get $p)))
    (global.set $g (global.get $g))
    (table.set $t (i32.const 0) (table.get $t (i32.const 0)))
    (drop (call $id (struct.get $s 0 (ref.as_non_null (local.get $p)))))
    (drop (call $id (array.get $a (local.get $x) (i32.const 0))))
    (drop (block (result (ref (exact $s))) (br_on_non_null 0 (local.get $p)) (unreachable)))
    (block (br_on_null 0 (local.get $p)) (call $id) (drop))
    (drop (select (result (ref null (exact $s))) (local.get $p) (local.get $l) (i32.const 1)))
    (drop (block $c (result (ref null (exact $s))) (try_table (catch $e $c) (unreachable)) (unreachable)))
    (drop (call_ref $f (local.get $p) (ref.func $id)))
    (ref.as_non_null (local.get $p)))
  (elem declare func $id))
