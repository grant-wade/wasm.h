    (import "M" "a" (global $a (ref (exact $A)))))
  "incompatible import type")

(module
  (rec (type $A (descriptor $D) (struct (field i32))) (type $D (describes $A) (struct)))
  (global $d (ref (exact $D)) (struct.new $D))
  (global $d2 (ref (exact $D)) (struct.new $D))
  (global $a (ref $A) (struct.new_desc $A (i32.const 7) (global.get $d)))
  (func $multi (export "multi") (param $which i32) (result i32)
    (local $x i64) (local $r (ref null $A))
    (block $l (result i32 i64 (ref $A))
      (i32.const 1000) (i64.const 5) (global.get $a)
      (br_on_cast_desc_eq $l anyref (ref $A) (if (result (ref null (exact $D))) (local.get $which) (then (global.get $d)) (else (global.get $d2))))
      (drop) (drop) (drop)
      (return (i32.const -1)))
    (local.set $r) (local.set $x)
    (i32.add (struct.get $A 0 (local.get $r)))
    (i32.add (i32.wrap_i64 (local.get $x))))
  (func (export "deep") (param $which i32) (result i32)
    (block $outer (result (ref $A))
      (i32.const 1) (i32.const 2) (i32.const 3)
      (block $inner (result i32)
        (i32.const 4)
        (drop (br_on_cast_desc_eq $outer anyref (ref $A) (global.get $a) (if (result (ref null (exact $D))) (local.get $which) (then (global.get $d)) (else (global.get $d2)))))
        (drop) (i32.const 5))
      (drop) (drop) (drop) (drop)
      (return (i32.const -2)))
    (struct.get $A 0))
  (func (export "deepfail") (param $which i32) (result i32)
    (block $outer (result anyref)
      (i32.const 1) (i32.const 2) (i32.const 3)
      (block $inner (result i32)
        (i32.const 4)
        (drop (br_on_cast_desc_eq_fail $outer anyref (ref $A) (global.get $a) (if (result (ref null (exact $D))) (local.get $which) (then (global.get $d)) (else (global.get $d2)))))
        (drop) (i32.const 5))
      (drop) (drop) (drop) (drop)
      (return (i32.const -2)))
    (drop) (i32.const 42))
  (func (export "loop") (result i32)
    (local $n i32)
    (local $r anyref)
    (local.set $r (global.get $a))
    (local.get $r)
    (loop $l (param anyref) (result anyref)
      (local.set $n (i32.add (local.get $n) (i32.const 1)))
      (if (param anyref) (result anyref) (i32.ge_u (local.get $n) (i32.const 3))
        (then (return (local.get $n))))
      (br_on_cast_desc_eq $l anyref (ref $A) (global.get $d))
    )
    (drop) (i32.const -3))
)
