(module $M
  (rec
    (type $A (sub (descriptor $Ad) (struct (field i32))))
    (type $Ad (sub (describes $A) (struct (field i32))))
    (type $B (sub $A (descriptor $Bd) (struct (field i32) (field i64))))
    (type $Bd (sub $Ad (describes $B) (struct (field i32))))
  )
  (type $arr (array i8))
  (type $plain (struct))
  (global $ad (export "ad") (ref (exact $Ad)) (struct.new $Ad (i32.const 1)))
  (global $ad2 (ref (exact $Ad)) (struct.new $Ad (i32.const 1)))
  (global $bd (ref (exact $Bd)) (struct.new $Bd (i32.const 2)))
  (global $a (export "a") (ref $A) (struct.new_desc $A (i32.const 10) (global.get $ad)))
  (global $b (ref $A) (struct.new_desc $B (i32.const 20) (i64.const 3) (global.get $bd)))
  (func (export "getdesc-b-is-bd") (result i32)
    (ref.eq (ref.get_desc $A (global.get $b)) (global.get $bd)))
  (func (export "getdesc-b-test-exact-bd") (result i32)
    (ref.test (ref (exact $Bd)) (ref.get_desc $A (global.get $b))))
  (func (export "cast-a-ad") (result i32)
    (struct.get $A 0 (ref.cast_desc_eq (ref $A) (global.get $a) (global.get $ad))))
  (func (export "cast-a-ad2")
    (drop (ref.cast_desc_eq (ref $A) (global.get $a) (global.get $ad2))))
  (func (export "cast-b-bd") (result i64)
    (struct.get $B 1 (ref.cast_desc_eq (ref $B) (global.get $b) (global.get $bd))))
  (func (export "cast-b-ad")
    (drop (ref.cast_desc_eq (ref $A) (global.get $b) (global.get $ad))))
  (func (export "cast-i31")
    (drop (ref.cast_desc_eq (ref $A) (ref.i31 (i32.const 5)) (global.get $ad))))
  (func (export "cast-arr")
    (drop (ref.cast_desc_eq (ref $A) (array.new_default $arr (i32.const 3)) (global.get $ad))))
  (func (export "cast-plain")
    (drop (ref.cast_desc_eq (ref $A) (struct.new $plain) (global.get $ad))))
  (func (export "cast-ext") (param externref)
    (drop (ref.cast_desc_eq (ref $A) (any.convert_extern (local.get 0)) (global.get $ad))))
  (func (export "cast-null-nn")
    (drop (ref.cast_desc_eq (ref $A) (ref.null none) (global.get $ad))))
  (func (export "cast-null-n") (result i32)
    (ref.is_null (ref.cast_desc_eq (ref null $A) (ref.null none) (global.get $ad))))
  (func (export "cast-nulldesc-null")
    (drop (ref.cast_desc_eq (ref null $A) (ref.null none) (ref.null none))))
  (func (export "cast-desc-desc") (result i32)
    (ref.is_null (ref.cast_desc_eq (ref null $A) (global.get $ad) (global.get $ad))))
  (func (export "br-unrelated") (param anyref) (result i32)
    (block $l (result (ref $A))
      (br_on_cast_desc_eq $l (ref null $plain) (ref $A) (ref.cast (ref null $plain) (local.get 0)) (global.get $ad))
      (drop) (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "br-null") (result i32)
    (block $l (result (ref null $A))
      (br_on_cast_desc_eq $l anyref (ref null $A) (ref.null none) (global.get $ad))
      (drop) (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "brf-null") (result i32)
    (block $l (result anyref)
      (br_on_cast_desc_eq_fail $l anyref (ref null $A) (ref.null none) (global.get $ad))
      (drop) (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "brf-nn-null") (result i32)
    (block $l (result anyref)
      (br_on_cast_desc_eq_fail $l anyref (ref $A) (ref.null none) (global.get $ad))
      (drop) (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "br-nulldesc") (result i32)
    (block $l (result anyref)
      (br_on_cast_desc_eq $l anyref (ref $A) (global.get $a) (ref.null none))
      (drop) (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "br-match") (result i32)
    (block $l (result anyref)
      (br_on_cast_desc_eq $l anyref (ref $A) (global.get $a) (global.get $ad))
      (drop) (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "test-exact-b-as-a") (result i32) (ref.test (ref (exact $A)) (global.get $b)))
  (func (export "test-exact-b-as-b") (result i32) (ref.test (ref (exact $B)) (global.get $b)))
)
(assert_return (invoke "getdesc-b-is-bd") (i32.const 1))
(assert_return (invoke "getdesc-b-test-exact-bd") (i32.const 1))
(assert_return (invoke "cast-a-ad") (i32.const 10))
(assert_trap (invoke "cast-a-ad2") "descriptor cast failure")
(assert_return (invoke "cast-b-bd") (i64.const 3))
(assert_trap (invoke "cast-b-ad") "descriptor cast failure")
(assert_trap (invoke "cast-i31") "descriptor cast failure")
(assert_trap (invoke "cast-arr") "descriptor cast failure")
(assert_trap (invoke "cast-plain") "descriptor cast failure")
(assert_trap (invoke "cast-ext" (ref.extern 7)) "descriptor cast failure")
(assert_trap (invoke "cast-null-nn") "descriptor cast failure")
(assert_return (invoke "cast-null-n") (i32.const 1))
(assert_trap (invoke "cast-nulldesc-null") "null descriptor reference")
(assert_trap (invoke "cast-desc-desc") "descriptor cast failure")
(assert_return (invoke "br-unrelated" (ref.null any)) (i32.const 0))
(assert_return (invoke "br-null") (i32.const 1))
(assert_return (invoke "brf-null") (i32.const 0))
(assert_return (invoke "brf-nn-null") (i32.const 1))
(assert_trap (invoke "br-nulldesc") "null descriptor reference")
(assert_return (invoke "br-match") (i32.const 1))
(assert_return (invoke "test-exact-b-as-a") (i32.const 0))
(assert_return (invoke "test-exact-b-as-b") (i32.const 1))
(register "M" $M)
(module $N
  (rec
    (type $A (sub (descriptor $Ad) (struct (field i32))))
    (type $Ad (sub (describes $A) (struct (field i32))))
    (type $B (sub $A (descriptor $Bd) (struct (field i32) (field i64))))
    (type $Bd (sub $Ad (describes $B) (struct (field i32))))
  )
  (import "M" "ad" (global $ad (ref (exact $Ad))))
  (import "M" "a" (global $a (ref $A)))
  (func (export "x") (result i32)
    (struct.get $A 0 (ref.cast_desc_eq (ref (exact $A)) (global.get $a) (global.get $ad))))
  (func (export "y") (result i32) (ref.test (ref (exact $A)) (global.get $a)))
)
(assert_return (invoke "x") (i32.const 10))
(assert_return (invoke "y") (i32.const 1))
(assert_unlinkable
  (module
