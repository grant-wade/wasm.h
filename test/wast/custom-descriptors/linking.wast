(module $A
  (type $super (sub (func)))
  (type $sub (sub $super (func)))
  (func (export "f") (type $sub))
)
(register "A" $A)
(module $B
  (type $super (sub (func)))
  (type $sub (sub $super (func)))
  (import "A" "f" (func $f (type $super)))
  (export "f" (func $f))
  (table $t 1 funcref)
  (elem (table $t) (i32.const 0) func $f)
  (func (export "test-exact-super") (result i32) (ref.test (ref (exact $super)) (ref.func $f)))
  (func (export "test-exact-sub") (result i32) (ref.test (ref (exact $sub)) (ref.func $f)))
  (func (export "test-sub") (result i32) (ref.test (ref $sub) (ref.func $f)))
  (func (export "ci-sub") (call_indirect $t (type $sub) (i32.const 0)))
  (func (export "ci-super") (call_indirect $t (type $super) (i32.const 0)))
)
(register "B" $B)
(assert_return (invoke $B "test-exact-super") (i32.const 0))
(assert_return (invoke $B "test-exact-sub") (i32.const 1))
(assert_return (invoke $B "test-sub") (i32.const 1))
(assert_return (invoke $B "ci-sub"))
(assert_return (invoke $B "ci-super"))
(module $C1
  (type $super (sub (func)))
  (type $sub (sub $super (func)))
  (import "B" "f" (func (exact (type $sub)))))
(assert_unlinkable
  (module
    (type $super (sub (func)))
    (type $sub (sub $super (func)))
    (import "B" "f" (func (exact (type $super)))))
  "incompatible import type")
(module $C2
  (type $super (sub (func)))
  (type $sub (sub $super (func)))
  (import "B" "f" (func $g (type $super)))
  (func (export "t") (result i32) (ref.test (ref (exact $sub)) (ref.func $g)))
  (elem declare func $g))
(assert_return (invoke $C2 "t") (i32.const 1))

(module $CA
  (type $t (func (param i32)))
  (type $u (sub (func (param i32))))
  (func (export "f") (type $t))
  (func (export "g") (type $t))
  (func (export "h") (type $u)))
(register "CA" $CA)
(module $CB
  (type $t (func (param i32)))
  (import "CA" (item "f" (func (exact (type $t)))) (item "g" (func (exact (type $t)))))
  (import "CA" (item "f") (item "g") (func (exact (type $t))))
  (elem declare func 0 1 2 3)
  (func (export "t") (result i32)
    (i32.add (i32.add (ref.test (ref (exact $t)) (ref.func 0)) (ref.test (ref (exact $t)) (ref.func 1)))
             (i32.add (ref.test (ref (exact $t)) (ref.func 2)) (ref.test (ref (exact $t)) (ref.func 3))))))
(assert_return (invoke $CB "t") (i32.const 4))
(assert_unlinkable
  (module
    (type $t (func (param i32)))
    (import "CA" (item "f") (item "h") (func (exact (type $t)))))
  "incompatible import type")
(assert_invalid
  (module
    (type $t (func))
    (import "CA" (item "f") (item "g") (func (type $t)))
    (global (ref (exact $t)) (ref.func 0)))
  "type mismatch")

(module $T
  (type $f (func))
  (table (export "te") 1 (ref null (exact $f)))
  (table (export "ti") 1 (ref null $f))
  (global (export "ge") (mut (ref null (exact $f))) (ref.null nofunc))
  (global (export "gi") (mut (ref null $f)) (ref.null nofunc)))
(register "T" $T)
(module (type $f (func)) (import "T" "te" (table 1 (ref null (exact $f)))))
(module (type $f (func)) (import "T" "ti" (table 1 (ref null $f))))
(assert_unlinkable (module (type $f (func)) (import "T" "te" (table 1 (ref null $f)))) "incompatible import type")
(assert_unlinkable (module (type $f (func)) (import "T" "ti" (table 1 (ref null (exact $f))))) "incompatible import type")
(module (type $f (func)) (import "T" "ge" (global (mut (ref null (exact $f))))))
(assert_unlinkable (module (type $f (func)) (import "T" "ge" (global (mut (ref null $f))))) "incompatible import type")
(assert_unlinkable (module (type $f (func)) (import "T" "gi" (global (mut (ref null (exact $f)))))) "incompatible import type")
