(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (type $f1 (func (param i32) (result i32)))
  (type $c1 (cont $f1))
  (tag $t (param i32) (result i32))
  (tag $u (param i32) (result i32))
  (tag $e (param i32))
  (global $log (mut i32) (i32.const 0))
  (func $log (param i32) (global.set $log (i32.add (i32.mul (global.get $log) (i32.const 10)) (local.get 0))))

  (func $inner (result i32)
    (call $log (i32.const 1))
    (drop (suspend $t (i32.const 1)))
    (call $log (i32.const 2))
    (drop (suspend $u (i32.const 2)))
    (call $log (i32.const 3))
    (i32.const 30))
  (func $mid (result i32)
    (local $k (ref null $c1))
    (block $hu (result i32 (ref $c1))
      (return (i32.add (i32.const 100) (resume $c0 (on $u $hu) (cont.new $c0 (ref.func $inner))))))
    (local.set $k)
    (drop)
    (call $log (i32.const 4))
    (i32.add (i32.const 100) (resume $c1 (i32.const 0) (local.get $k))))
  (elem declare func $inner $mid)
  (func $deep (param $k (ref null $c1)) (result i32)
    (call $log (i32.const 5))
    (i32.add (i32.const 1000) (resume $c1 (i32.const 0) (local.get $k))))
  (func (export "multi") (result i32)
    (local $k (ref null $c1))
    (block $ht (result i32 (ref $c1))
      (return (resume $c0 (on $t $ht) (cont.new $c0 (ref.func $mid)))))
    (local.set $k)
    (drop)
    (call $deep (local.get $k)))
  (func (export "log") (result i32) (global.get $log))

  (func $inner2 (result i32) (drop (suspend $t (i32.const 1))) (i32.const -1))
  (func $mid2 (result i32)
    (block $c (result i32)
      (try_table (catch $e $c)
        (return (resume $c0 (cont.new $c0 (ref.func $inner2)))))
      (unreachable))
    (i32.add (i32.const 500)))
  (elem declare func $inner2 $mid2)
  (func (export "rthrow-multi") (result i32)
    (local $k (ref null $c1))
    (block $ht (result i32 (ref $c1))
      (return (resume $c0 (on $t $ht) (cont.new $c0 (ref.func $mid2)))))
    (local.set $k)
    (drop)
    (resume_throw $c1 $e (i32.const 7) (local.get $k)))

  (func $twice (result i32) (drop (suspend $t (i32.const 1))) (drop (suspend $t (i32.const 2))) (i32.const 0))
  (elem declare func $twice)
  (func $f2 (param $k (ref null $c1)) (result i32)
    (block $b (result i32 (ref $c1))
      (return (resume $c1 (on $t $b) (i32.const 0) (local.get $k))))
    (drop) (i32.add (i32.const 220)))
  (func (export "rehandle") (result i32)
    (local $k (ref null $c1))
    (block $a (result i32 (ref $c1))
      (return (resume $c0 (on $t $a) (cont.new $c0 (ref.func $twice)))))
    (local.set $k) (drop)
    (call $f2 (local.get $k)))
  (func (export "rehandle-missing") (result i32)
    (local $k (ref null $c1))
    (block $a (result i32 (ref $c1))
      (return (resume $c0 (on $t $a) (cont.new $c0 (ref.func $twice)))))
    (local.set $k) (drop)
    (resume $c1 (i32.const 0) (local.get $k)))
)
(assert_return (invoke "multi") (i32.const 1130))
(assert_return (invoke "log") (i32.const 15243))
(assert_return (invoke "rthrow-multi") (i32.const 507))
(assert_return (invoke "rehandle") (i32.const 222))
(assert_suspension (invoke "rehandle-missing") "unhandled")
