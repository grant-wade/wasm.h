(module
  (rec
    (type $fk (func (param i32 (ref null $ck)) (result i32)))
    (type $ck (cont $fk)))
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (tag $sw (result i32))
  (global $log (mut i32) (i32.const 0))

  (func $pp (type $fk)
    (local $n i32) (local $peer (ref null $ck))
    (local.set $n (local.get 0))
    (local.set $peer (local.get 1))
    (loop $l
      (global.set $log (i32.add (i32.mul (global.get $log) (i32.const 10)) (i32.rem_u (local.get $n) (i32.const 10))))
      (if (i32.ge_u (local.get $n) (i32.const 6))
        (then (return (i32.mul (local.get $n) (i32.const 100)))))
      (switch $ck $sw (i32.add (local.get $n) (i32.const 1)) (local.get $peer))
      (local.set $peer)
      (local.set $n)
      (br $l))
    (unreachable))
  (elem declare func $pp)
  (func $start (result i32)
    (switch $ck $sw (i32.const 1) (cont.new $ck (ref.func $pp)))
    (call $pp))
  (elem declare func $start)
  (func (export "pingpong") (result i32)
    (resume $c0 (on $sw switch) (cont.new $c0 (ref.func $start))))
  (func (export "log") (result i32) (global.get $log))

  (func $lonely (result i32)
    (call $pp (switch $ck $sw (i32.const 1) (cont.new $ck (ref.func $pp)))))
  (elem declare func $lonely)
  (func (export "unhandled") (result i32)
    (resume $c0 (cont.new $c0 (ref.func $lonely))))
  (func $tonull (result i32)
    (call $pp (switch $ck $sw (i32.const 1) (ref.null $ck))))
  (elem declare func $tonull)
  (func (export "null-unhandled") (result i32)
    (resume $c0 (cont.new $c0 (ref.func $tonull))))
  (func (export "toplevel") (result i32)
    (call $pp (switch $ck $sw (i32.const 1) (cont.new $ck (ref.func $pp)))))
)
(assert_return (invoke "pingpong") (i32.const 600))
(assert_return (invoke "log") (i32.const 123456))
(assert_suspension (invoke "unhandled") "unhandled tag")
(assert_trap (invoke "null-unhandled") "null continuation reference")
(assert_suspension (invoke "toplevel") "unhandled tag")

(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (rec
    (type $fs (func (param (ref null $cs)) (result i32)))
    (type $cs (cont $fs)))
  (tag $sw (result i32))
  (tag $y)
  (global $log (mut i32) (i32.const 0))
  (func $log (param i32) (global.set $log (i32.add (i32.mul (global.get $log) (i32.const 10)) (local.get 0))))
  (func $B (result i32)
    (call $log (i32.const 1))
    (drop (switch $cs $sw (cont.new $cs (ref.func $C))))
    (call $log (i32.const 3))
    (suspend $y)
    (call $log (i32.const 5))
    (i32.const 5))
  (func $C (type $fs)
    (call $log (i32.const 2))
    (drop (switch $cs $sw (local.get 0)))
    (unreachable))
  (func $A (result i32)
    (local $k (ref null $c0))
    (block $hy (result (ref $c0))
      (return (i32.add (i32.const 10) (resume $c0 (on $y $hy) (cont.new $c0 (ref.func $B))))))
    (local.set $k)
    (call $log (i32.const 4))
    (i32.add (i32.const 20) (resume $c0 (local.get $k))))
  (elem declare func $A $B $C)
  (func (export "go") (result i32)
    (resume $c0 (on $sw switch) (cont.new $c0 (ref.func $A))))
  (func (export "log") (result i32) (global.get $log))
)
(assert_return (invoke "go") (i32.const 25))
(assert_return (invoke "log") (i32.const 12345))

(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (rec
    (type $fs (func (param (ref null $cs)) (result i32)))
    (type $cs (cont $fs)))
  (tag $sw (result i32))
  (tag $give (param (ref null $cs)))
  (tag $e (param i32))
  (func $B (result i32)
    (local $r (ref null $cs))
    (local.set $r (switch $cs $sw (cont.new $cs (ref.func $C))))
    (i32.add (i32.const 5) (ref.is_null (local.get $r))))
  (func $C (type $fs)
    (suspend $give (local.get 0))
    (unreachable))
  (func $Bt (result i32)
    (block $c (result i32)
      (try_table (catch $e $c)
        (drop (switch $cs $sw (cont.new $cs (ref.func $C))))
        (unreachable))
      (unreachable))
    (i32.add (i32.const 100)))
  (elem declare func $B $C $Bt)
  (func (export "resume-captured") (result i32)
    (local $k (ref null $cs))
    (block $h (result (ref null $cs) (ref $c0))
      (return (resume $c0 (on $sw switch) (on $give $h) (cont.new $c0 (ref.func $B)))))
    (drop)
    (local.set $k)
    (resume $cs (ref.null $cs) (local.get $k)))
  (func (export "throw-captured") (result i32)
    (local $k (ref null $cs))
    (block $h (result (ref null $cs) (ref $c0))
      (return (resume $c0 (on $sw switch) (on $give $h) (cont.new $c0 (ref.func $Bt)))))
    (drop)
    (local.set $k)
    (resume_throw $cs $e (i32.const 7) (local.get $k)))
)
(assert_return (invoke "resume-captured") (i32.const 6))
(assert_return (invoke "throw-captured") (i32.const 107))
