(module $P
  (type $f (func (param i32) (result i32)))
  (type $c (cont $f))
  (tag $y (export "y") (param i32) (result i32))
  (func $body (param i32) (result i32) (i32.add (suspend $y (local.get 0)) (i32.const 1)))
  (func $plain (param i32) (result i32) (i32.mul (local.get 0) (i32.const 3)))
  (elem declare func $body $plain)
  (func (export "make") (result (ref $c)) (cont.new $c (ref.func $body)))
  (func (export "make-plain") (result (ref $c)) (cont.new $c (ref.func $plain)))
)
(register "P")
(module
  (type $u (func))
  (type $g (func (param i32) (result i32)))
  (type $k (cont $g))
  (type $s (struct (field (mut (ref null $k)))))
  (tag $y (import "P" "y") (param i32) (result i32))
  (import "P" "make" (func $make (result (ref $k))))
  (import "P" "make-plain" (func $make-plain (result (ref $k))))
  (global $glob (mut (ref null $k)) (ref.null $k))
  (table $tab 2 (ref null $k))
  (func (export "global") (result i32)
    (global.set $glob (call $make-plain))
    (resume $k (i32.const 5) (global.get $glob)))
  (func (export "table") (result i32)
    (table.set $tab (i32.const 0) (call $make-plain))
    (table.fill $tab (i32.const 1) (call $make-plain) (i32.const 1))
    (drop (table.grow $tab (call $make-plain) (i32.const 1)))
    (resume $k (i32.const 5) (table.get $tab (i32.const 0))))
  (func (export "struct") (result i32)
    (local $x (ref null $s))
    (local.set $x (struct.new $s (call $make-plain)))
    (struct.set $s 0 (local.get $x) (call $make-plain))
    (resume $k (i32.const 5) (struct.get $s 0 (local.get $x))))
  (func (export "captured") (result i32)
    (block $h (result i32 (ref $k))
      (return (resume $k (on $y $h) (i32.const 10) (call $make))))
    (global.set $glob)
    (drop)
    (resume $k (i32.const 5) (global.get $glob)))
)
(assert_return (invoke "global") (i32.const 15))
(assert_return (invoke "table") (i32.const 15))
(assert_return (invoke "struct") (i32.const 15))
(assert_return (invoke "captured") (i32.const 6))

(module $F (type $t (func)) (func $f (type $t)) (func (export "get") (result (ref $t)) (ref.func $f)) (elem declare func $f))
(register "F")
(module
  (type $x (struct))
  (type $y (struct))
  (type $t (func))
  (import "F" "get" (func $get (result (ref $t))))
  (global $g (mut (ref null $t)) (ref.null $t))
  (table $tab 1 (ref null $t))
  (func (export "funcref") (result i32)
    (global.set $g (call $get))
    (table.set $tab (i32.const 0) (call $get))
    (table.fill $tab (i32.const 0) (call $get) (i32.const 1))
    (drop (table.grow $tab (call $get) (i32.const 1)))
    (i32.add (ref.is_null (global.get $g)) (ref.is_null (table.get $tab (i32.const 1))))))
(assert_return (invoke "funcref") (i32.const 0))

(module $X1
  (tag $t (export "t"))
  (func (export "sus") (suspend $t)))
(register "X1")
(module $X2
  (tag $t (export "t"))
  (func (export "sus") (suspend $t)))
(register "X2")
(module
  (type $f (func))
  (type $c (cont $f))
  (tag $t1 (import "X1" "t"))
  (import "X2" "sus" (func $sus2))
  (import "X1" "sus" (func $sus1))
  (elem declare func $sus1 $sus2)
  (func (export "same") (result i32)
    (block $h (result (ref $c))
      (resume $c (on $t1 $h) (cont.new $c (ref.func $sus1)))
      (return (i32.const 0)))
    (drop) (i32.const 1))
  (func (export "other") (result i32)
    (block $h (result (ref $c))
      (resume $c (on $t1 $h) (cont.new $c (ref.func $sus2)))
      (return (i32.const 0)))
    (drop) (i32.const 1))
)
(assert_return (invoke "same") (i32.const 1))
(assert_suspension (invoke "other") "unhandled")

(module $A
  (tag $t (export "t") (param i32) (result i32))
  (tag $u (export "u") (param i32) (result i32))
  (func (export "sus") (param i32) (result i32) (suspend $t (local.get 0)))
  (func (export "susu") (param i32) (result i32) (suspend $u (local.get 0))))
(register "A")
(module $B
  (tag $t (import "A" "t") (param i32) (result i32))
  (export "t2" (tag $t)))
(register "B")
(module $C
  (type $f (func (param i32) (result i32)))
  (type $c (cont $f))
  (tag $t (import "B" "t2") (param i32) (result i32))
  (tag $own (param i32) (result i32))
  (func $sus (import "A" "sus") (param i32) (result i32))
  (func $susu (import "A" "susu") (param i32) (result i32))
  (elem declare func $sus $susu)
  (func (export "reexported") (result i32)
    (local $k (ref null $c))
    (block $h (result i32 (ref $c))
      (return (resume $c (on $t $h) (i32.const 3) (cont.new $c (ref.func $sus)))))
    (local.set $k)
    (i32.add (i32.const 10))
    (resume $c (local.get $k)))
  (func (export "distinct") (result i32)
    (block $h (result i32 (ref $c))
      (return (resume $c (on $own $h) (on $t $h) (i32.const 3) (cont.new $c (ref.func $susu)))))
    (unreachable))
)
(assert_return (invoke "reexported") (i32.const 13))
(assert_suspension (invoke "distinct") "unhandled")

(module $T
  (tag (export "t") (param i32) (result i32))
  (tag (export "e") (param i32)))
(register "T")
(module (tag (import "T" "t") (param i32) (result i32)))
(assert_unlinkable (module (tag (import "T" "t") (param i32) (result i64))) "")
(assert_unlinkable (module (tag (import "T" "t") (param i32))) "")
(assert_unlinkable (module (tag (import "T" "e") (param i32) (result i32))) "")
