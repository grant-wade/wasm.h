(module
  (type $f (func (result i32)))
  (type $c (cont $f))
  (type $s (struct (field (mut (ref null $c))) (field contref)))
  (type $a (array (mut (ref null $c))))
  (func $one (result i32) (i32.const 1))
  (func $two (result i32) (i32.const 2))
  (elem declare func $one $two)
  (func (export "struct") (result i32)
    (local $x (ref null $s))
    (local.set $x (struct.new $s (cont.new $c (ref.func $one)) (ref.null cont)))
    (struct.set $s 0 (local.get $x) (cont.new $c (ref.func $two)))
    (resume $c (struct.get $s 0 (local.get $x))))
  (func (export "array") (result i32)
    (local $x (ref null $a))
    (local.set $x (array.new $a (ref.null $c) (i32.const 4)))
    (array.set $a (local.get $x) (i32.const 1) (cont.new $c (ref.func $two)))
    (array.copy $a $a (local.get $x) (i32.const 3) (local.get $x) (i32.const 1) (i32.const 1))
    (i32.add
      (resume $c (array.get $a (local.get $x) (i32.const 3)))
      (ref.is_null (array.get $a (local.get $x) (i32.const 0)))))
  (func (export "array-consumed") (result i32)
    (local $x (ref null $a))
    (local.set $x (array.new $a (cont.new $c (ref.func $two)) (i32.const 2)))
    (drop (resume $c (array.get $a (local.get $x) (i32.const 0))))
    (resume $c (array.get $a (local.get $x) (i32.const 1))))
)
(assert_return (invoke "struct") (i32.const 2))
(assert_return (invoke "array") (i32.const 3))
(assert_trap (invoke "array-consumed") "continuation already consumed")

(module
  (type $f (func (result i32)))
  (type $c (cont $f))
  (func $one (result i32) (i32.const 1))
  (elem declare func $one)
  (func (export "br_on_null") (param i32) (result i32)
    (block $null
      (return (resume $c (br_on_null $null (select (result (ref null $c)) (cont.new $c (ref.func $one)) (ref.null $c) (local.get 0))))))
    (i32.const -1))
  (func (export "br_on_non_null") (param i32) (result i32)
    (block $nn (result (ref $c))
      (br_on_non_null $nn (select (result (ref null $c)) (cont.new $c (ref.func $one)) (ref.null $c) (local.get 0)))
      (return (i32.const -1)))
    (resume $c))
  (func (export "as_non_null") (result i32)
    (resume $c (ref.as_non_null (ref.null $c))))
  (func (export "local-default") (result i32)
    (local $k (ref null $c))
    (ref.is_null (local.get $k)))
)
(assert_return (invoke "br_on_null" (i32.const 1)) (i32.const 1))
(assert_return (invoke "br_on_null" (i32.const 0)) (i32.const -1))
(assert_return (invoke "br_on_non_null" (i32.const 1)) (i32.const 1))
(assert_return (invoke "br_on_non_null" (i32.const 0)) (i32.const -1))
(assert_trap (invoke "as_non_null") "null reference")
(assert_return (invoke "local-default") (i32.const 1))
