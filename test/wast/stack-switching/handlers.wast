(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (type $f1 (func (param i32) (result i32)))
  (type $c1 (cont $f1))
  (rec
    (type $fs (func (param (ref null $cs)) (result i32)))
    (type $cs (cont $fs)))
  (tag $t (result i32))

  (func $sus (result i32)
    (i32.add (suspend $t) (i32.const 100)))
  (func $target (type $fs) (i32.const 7))
  (func $sw (result i32)
    (drop (switch $cs $t (cont.new $cs (ref.func $target)))) (i32.const -3))
  (elem declare func $sus $target $sw)

  (func (export "suspend-both") (result i32)
    (local $k (ref null $c1))
    (block $h (result (ref $c1))
      (return (resume $c0 (on $t switch) (on $t $h) (cont.new $c0 (ref.func $sus)))))
    (local.set $k)
    (resume $c1 (i32.const 5) (local.get $k)))
  (func (export "switch-both") (result i32)
    (block $h (result (ref $c1))
      (return (resume $c0 (on $t $h) (on $t switch) (cont.new $c0 (ref.func $sw)))))
    (drop) (i32.const -1))
  (func $inner (result i32)
    (resume $c0 (on $t switch) (cont.new $c0 (ref.func $sus))))
  (elem declare func $inner)
  (func (export "suspend-skips-switch") (result i32)
    (local $k (ref null $c1))
    (block $h (result (ref $c1))
      (return (resume $c0 (on $t $h) (cont.new $c0 (ref.func $inner)))))
    (local.set $k)
    (resume $c1 (i32.const 1) (local.get $k)))
  (func $inner2 (result i32)
    (block $h (result (ref $c1))
      (return (resume $c0 (on $t $h) (cont.new $c0 (ref.func $sw)))))
    (drop) (i32.const -2))
  (elem declare func $inner2)
  (func (export "switch-skips-label") (result i32)
    (resume $c0 (on $t switch) (cont.new $c0 (ref.func $inner2))))
  (func (export "first-wins") (result i32)
    (block $h2 (result (ref $c1))
      (block $h1 (result (ref $c1))
        (return (resume $c0 (on $t $h1) (on $t $h2) (cont.new $c0 (ref.func $sus)))))
      (drop) (return (i32.const 1)))
    (drop) (i32.const 2))
)
(assert_return (invoke "suspend-both") (i32.const 105))
(assert_return (invoke "switch-both") (i32.const 7))
(assert_return (invoke "suspend-skips-switch") (i32.const 101))
(assert_return (invoke "switch-skips-label") (i32.const 7))
(assert_return (invoke "first-wins") (i32.const 1))

(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (type $f1 (func (param i32) (result i32)))
  (type $c1 (cont $f1))
  (tag $t (param i32) (result i32))
  (func $sus (result i32) (i32.add (suspend $t (i32.const 4)) (i32.const 1)))
  (elem declare func $sus)
  (func $fnlabel (result i32 (ref $c1))
    (resume $c0 (on $t 0) (cont.new $c0 (ref.func $sus)))
    (unreachable))
  (func (export "fn-label") (result i32)
    (local $k (ref null $c1))
    (call $fnlabel)
    (local.set $k)
    (resume $c1 (local.get $k)))
  (func (export "if-label") (param i32) (result i32)
    (local $k (ref null $c1))
    (if (result i32 (ref $c1)) (local.get 0)
      (then (resume $c0 (on $t 0) (cont.new $c0 (ref.func $sus))) (unreachable))
      (else (unreachable)))
    (local.set $k)
    (i32.mul (i32.const 10))
    (resume $c1 (local.get $k)))
  (func (export "try-table-label") (result i32)
    (local $k (ref null $c1))
    (try_table (result i32 (ref $c1))
      (resume $c0 (on $t 0) (cont.new $c0 (ref.func $sus))) (unreachable))
    (local.set $k)
    (resume $c1 (local.get $k)))
  (func (export "legacy-try-label") (result i32)
    (local $k (ref null $c1))
    try (result i32 (ref $c1))
      (resume $c0 (on $t 0) (cont.new $c0 (ref.func $sus))) (unreachable)
    catch_all
      (unreachable)
    end
    (local.set $k)
    (resume $c1 (local.get $k)))
  (func (export "discard") (result i32)
    (local $k (ref null $c1))
    (block $h (result i32 (ref $c1))
      (i32.const 111) (i32.const 222)
      (resume $c0 (on $t $h) (cont.new $c0 (ref.func $sus)))
      (unreachable))
    (local.set $k)
    (resume $c1 (local.get $k)))
)
(assert_return (invoke "fn-label") (i32.const 5))
(assert_return (invoke "if-label" (i32.const 1)) (i32.const 41))
(assert_return (invoke "try-table-label") (i32.const 5))
(assert_return (invoke "legacy-try-label") (i32.const 5))
(assert_return (invoke "discard") (i32.const 5))

(module
  (type $f1 (func (param i32) (result i32)))
  (type $c1 (cont $f1))
  (tag $y (param i32) (result i32))
  (func $gen (param i32) (result i32)
    (i32.add (local.get 0)
      (i32.add (suspend $y (i32.const 1))
        (i32.add (suspend $y (i32.const 2))
          (i32.add (suspend $y (i32.const 3)) (i32.const 100))))))
  (elem declare func $gen)
  (func (export "loop-label") (result i32)
    (i32.const 1000)
    (cont.new $c1 (ref.func $gen))
    (loop $l (param i32 (ref $c1)) (result i32)
      (resume $c1 (on $y $l))))
)
(assert_return (invoke "loop-label") (i32.const 1106))
