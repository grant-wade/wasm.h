(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (type $f1 (func (param i32) (result i32)))
  (type $c1 (cont $f1))
  (tag $e (param i32))
  (tag $y (result i32))
  (global $side (mut i32) (i32.const 0))
  (func $body (result i32) (global.set $side (i32.const 1)) (i32.const 9))
  (func $catch-all (result i32)
    (block $c (result exnref)
      (try_table (catch_all_ref $c) (drop (suspend $y)))
      (return (i32.const -1)))
    (throw_ref))
  (elem declare func $body $catch-all)

  (func (export "unstarted") (result i32)
    (block $c (result i32)
      (try_table (catch $e $c)
        (drop (resume_throw $c0 $e (i32.const 5) (cont.new $c0 (ref.func $body)))))
      (return (i32.const -1)))
    (i32.add (global.get $side)))
  (func (export "consumed-after") (result i32)
    (local $k (ref null $c0))
    (local.set $k (cont.new $c0 (ref.func $body)))
    (block $c (result i32)
      (try_table (catch $e $c)
        (drop (resume_throw $c0 $e (i32.const 5) (local.get $k))))
      (unreachable))
    (drop)
    (resume $c0 (local.get $k)))
  (func (export "throw-ref") (result i32)
    (local $k (ref null $c1))
    (local $x exnref)
    (block $c (result i32 exnref)
      (try_table (catch_ref $e $c) (throw $e (i32.const 33)))
      (unreachable))
    (local.set $x)
    (drop)
    (block $hy (result (ref $c1))
      (resume $c0 (on $y $hy) (cont.new $c0 (ref.func $catch-all)))
      (unreachable))
    (local.set $k)
    (block $c2 (result i32)
      (try_table (catch $e $c2)
        (drop (resume_throw_ref $c1 (local.get $x) (local.get $k))))
      (unreachable)))
  (func (export "null-both") (result i32)
    (resume_throw_ref $c1 (ref.null exn) (ref.null $c1)))
  (func (export "null-cont") (result i32)
    (resume_throw_ref $c1 (block (result exnref) (try_table (catch_all_ref 0) (throw $e (i32.const 1))) (unreachable)) (ref.null $c1)))
  (func (export "null-exn-consumed") (result i32)
    (local $k (ref null $c0))
    (local.set $k (cont.new $c0 (ref.func $body)))
    (drop (resume $c0 (local.get $k)))
    (resume_throw_ref $c0 (ref.null exn) (local.get $k)))
)
(assert_return (invoke "unstarted") (i32.const 5))
(assert_trap (invoke "consumed-after") "continuation already consumed")
(assert_return (invoke "throw-ref") (i32.const 33))
(assert_trap (invoke "null-both") "null exception reference")
(assert_trap (invoke "null-cont") "null continuation reference")
(assert_trap (invoke "null-exn-consumed") "null exception reference")

(module
  (type $f0 (func (result i32)))
  (type $c0 (cont $f0))
  (tag $e (param i32))
  (tag $y)
  (func $body (result i32)
    try (result i32)
      (throw $e (i32.const 9))
    catch $e
      drop
      (suspend $y)
      rethrow 0
    end)
  (elem declare func $body)
  (func (export "rethrow-after-resume") (result i32)
    (local $k (ref null $c0))
    (block $h (result (ref $c0))
      (return (resume $c0 (on $y $h) (cont.new $c0 (ref.func $body)))))
    (local.set $k)
    (block $c (result i32)
      (try_table (catch $e $c) (throw $e (i32.const 1)))
      (unreachable))
    (drop)
    (block $c2 (result i32)
      (try_table (catch $e $c2) (drop (resume $c0 (local.get $k))))
      (unreachable)))
)
(assert_return (invoke "rethrow-after-resume") (i32.const 9))
