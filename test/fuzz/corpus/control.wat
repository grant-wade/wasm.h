(module
  (tag $e (param i32))
  (func $thrower (param i32) (throw $e (local.get 0)))
  (func (export "catch") (result i32)
    (block $h (result i32)
      (try_table (catch $e $h) (call $thrower (i32.const 3)))
      (i32.const 0)))
  (func $fac (param i64) (result i64)
    (if (result i64) (i64.eqz (local.get 0))
      (then (i64.const 1))
      (else (i64.mul (local.get 0) (call $fac (i64.sub (local.get 0) (i64.const 1)))))))
  (func (export "fac") (result i64) (call $fac (i64.const 20)))
  (func $count (param i32) (result i32)
    (if (result i32) (i32.eqz (local.get 0)) (then (i32.const 0))
      (else (return_call $count (i32.sub (local.get 0) (i32.const 1))))))
  (func (export "tail") (result i32) (call $count (i32.const 100000)))
  (func (export "deep") (result i32) (call $deep_rec))
  (func $deep_rec (result i32) (call $deep_rec))
  (func (export "spin") (loop $l (br $l)))
  (func (export "div") (result i32) (i32.div_s (i32.const 1) (i32.const 0))))
