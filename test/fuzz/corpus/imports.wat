(module
  (import "env" "f" (func $f (param i32 i64) (result f64)))
  (import "env" "mem" (memory 1 4))
  (import "env" "tab" (table 2 funcref))
  (import "env" "g" (global $g (mut i32)))
  (import "env" "ref" (global $r externref))
  (import "env" "tag" (tag $t (param i32)))
  (func (export "run") (result i32)
    (drop (call $f (global.get $g) (i64.const 7)))
    (global.set $g (i32.add (global.get $g) (i32.const 1)))
    (i32.store (i32.const 8) (memory.grow (i32.const 1)))
    (drop (table.grow (ref.null func) (i32.const 3)))
    (block $h (result i32)
      (try_table (catch $t $h) (throw $t (i32.load (i32.const 8))))
      (i32.const -1))))
