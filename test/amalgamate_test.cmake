cmake_minimum_required(VERSION 3.20)
set(root "${TEST_BINARY_DIR}/amalgamate-fixture")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}/src/nested")
file(WRITE "${root}/src/amalgamation.h" "#include <stdint.h>\n#include \"nested/one.h\"\n#include \"nested/one.h\"\n#include \"runtime.c\"\nint tail;\n")
file(WRITE "${root}/src/runtime.c" "#include \"nested/one.h\"\nint runtime;\n")
file(WRITE "${root}/src/nested/one.h" "int first;\n#include \"two.inc\"\n")
file(WRITE "${root}/src/nested/two.inc" "#define VALUES a; b; c\n#define CONTINUED \\\n  42\n")
function(run expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DWASM_AMALGAMATE_ROOT=${root}"
        "-DWASM_AMALGAMATE_STAMP=${root}/header.stamp" ${ARGN}
        -P "${GENERATOR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "success" AND NOT result EQUAL 0)
        message(FATAL_ERROR "Unexpected generator failure: ${output}${error}")
    elseif(expected STREQUAL "failure" AND result EQUAL 0)
        message(FATAL_ERROR "Generator unexpectedly succeeded")
    endif()
endfunction()
run(success)
file(READ "${root}/wasm.h" generated)
file(READ "${root}/header.stamp" fingerprint)
string(SHA256 expected_fingerprint "${generated}")
if(NOT fingerprint STREQUAL expected_fingerprint)
    message(FATAL_ERROR "Build stamp does not identify generated content")
endif()
foreach(text "#include <stdint.h>" "int first;" "int runtime;" "#define VALUES a; b; c" "#define CONTINUED \\\n  42" "int tail;")
    string(FIND "${generated}" "${text}" found)
    if(found LESS 0)
        message(FATAL_ERROR "Lost source text: ${text}")
    endif()
endforeach()
string(REGEX MATCHALL "BEGIN src/nested/one.h" repeats "${generated}")
list(LENGTH repeats count)
if(NOT count EQUAL 1 OR generated MATCHES "#include \"")
    message(FATAL_ERROR "Recursive include expansion or deduplication failed")
endif()
file(TIMESTAMP "${root}/wasm.h" before "%s")
file(TIMESTAMP "${root}/header.stamp" stamp_before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
run(success)
file(TIMESTAMP "${root}/wasm.h" after "%s")
file(TIMESTAMP "${root}/header.stamp" stamp_after "%s")
if(NOT before STREQUAL after OR NOT stamp_before STREQUAL stamp_after)
    message(FATAL_ERROR "Unchanged output was rewritten")
endif()
run(success -DWASM_AMALGAMATE_CHECK=ON)
file(APPEND "${root}/src/nested/two.inc" "int changed;\n")
run(failure -DWASM_AMALGAMATE_CHECK=ON)
file(READ "${root}/wasm.h" checked)
if(NOT checked STREQUAL generated)
    message(FATAL_ERROR "Check mode changed output")
endif()
file(READ "${root}/header.stamp" checked_fingerprint)
if(NOT checked_fingerprint STREQUAL fingerprint)
    message(FATAL_ERROR "Check mode changed the build stamp")
endif()
run(success)
file(READ "${root}/header.stamp" changed_fingerprint)
if(changed_fingerprint STREQUAL fingerprint)
    message(FATAL_ERROR "Changed content did not update the build stamp")
endif()
file(WRITE "${root}/src/nested/two.inc" "#include \"../amalgamation.h\"\n")
run(failure)
file(REMOVE "${root}/src/nested/two.inc")
run(failure)
