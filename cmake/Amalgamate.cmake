cmake_minimum_required(VERSION 3.20)

# Override the root only for isolated generator tests and index snapshots.
if(NOT DEFINED WASM_AMALGAMATE_ROOT)
    get_filename_component(WASM_AMALGAMATE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
get_filename_component(WASM_AMALGAMATE_ROOT "${WASM_AMALGAMATE_ROOT}" REALPATH)

function(wasm_expand path stack output)
    get_filename_component(path "${path}" REALPATH)
    file(RELATIVE_PATH label "${WASM_AMALGAMATE_ROOT}" "${path}")
    if(path IN_LIST stack)
        message(FATAL_ERROR "Recursive local include: ${label}")
    endif()
    get_property(included GLOBAL PROPERTY WASM_AMALGAMATE_INCLUDED)
    if(path IN_LIST included)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing local include: ${label}")
    endif()
    if(label MATCHES "^\\.\\./" OR NOT label MATCHES "^src/.*\\.(h|inc|c)$")
        message(FATAL_ERROR "Local include must be a .h, .inc, or .c file under src/: ${label}")
    endif()
    set_property(GLOBAL APPEND PROPERTY WASM_AMALGAMATE_INCLUDED "${path}")
    list(APPEND stack "${path}")
    get_filename_component(directory "${path}" DIRECTORY)
    file(READ "${path}" remaining)
    set(result "/* BEGIN ${label} */\n")
    # Work on whole strings rather than CMake lists, preserving semicolons,
    # backslashes and blank lines exactly. Each local file is emitted once.
    while(TRUE)
        string(REGEX MATCH "(^|\n)[ \t]*#[ \t]*include[ \t]+\"([^\"\n]+)\"[^\n]*(\n|$)" directive "${remaining}")
        if(directive STREQUAL "")
            string(APPEND result "${remaining}")
            break()
        endif()
        set(include "${CMAKE_MATCH_2}")
        string(FIND "${remaining}" "${directive}" position)
        string(SUBSTRING "${remaining}" 0 ${position} prefix)
        string(LENGTH "${directive}" length)
        math(EXPR next "${position} + ${length}")
        string(SUBSTRING "${remaining}" ${next} -1 remaining)
        string(APPEND result "${prefix}\n")
        wasm_expand("${directory}/${include}" "${stack}" expanded)
        string(APPEND result "${expanded}")
    endwhile()
    if(NOT result MATCHES "\n$")
        string(APPEND result "\n")
    endif()
    string(APPEND result "/* END ${label} */\n")
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

set_property(GLOBAL PROPERTY WASM_AMALGAMATE_INCLUDED "")
wasm_expand("${WASM_AMALGAMATE_ROOT}/src/amalgamation.h" "" body)
set(generated "/* Generated from src/amalgamation.h. Do not edit directly.\n * Regenerate: cmake -P cmake/Amalgamate.cmake\n */\n${body}")
set(destination "${WASM_AMALGAMATE_ROOT}/wasm.h")
set(existing "")
if(EXISTS "${destination}")
    file(READ "${destination}" existing)
endif()
if(NOT generated STREQUAL existing)
    if(WASM_AMALGAMATE_CHECK)
        message(FATAL_ERROR "wasm.h is stale. Run: cmake -P cmake/Amalgamate.cmake")
    endif()
    file(WRITE "${destination}" "${generated}")
endif()

# Only build-tree state is a declared CMake byproduct. Its content changes
# with the header, allowing Ninja to schedule dependent compilation correctly
# without making the tracked distribution header a cleanable build output.
if(DEFINED WASM_AMALGAMATE_STAMP AND NOT WASM_AMALGAMATE_CHECK)
    string(SHA256 fingerprint "${generated}")
    set(stamp "")
    if(EXISTS "${WASM_AMALGAMATE_STAMP}")
        file(READ "${WASM_AMALGAMATE_STAMP}" stamp)
    endif()
    if(NOT stamp STREQUAL fingerprint)
        file(WRITE "${WASM_AMALGAMATE_STAMP}" "${fingerprint}")
    endif()
endif()
